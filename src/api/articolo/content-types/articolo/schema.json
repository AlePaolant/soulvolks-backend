{
  "kind": "collectionType",
  "collectionName": "articolos",
  "info": {
    "singularName": "articolo",
    "pluralName": "articolos",
    "displayName": "Articolo"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "titolo": {
      "type": "string",
      "required": true,
      "unique": true
    },
    "contenuto": {
      "type": "text",
      "required": true
    },
    "immagine_principale": {
      "type": "media",
      "multiple": false,
      "allowedTypes": [
        "images",
        "files",
        "videos",
        "audios"
      ]
    },
    "gallery": {
      "type": "media",
      "multiple": true,
      "allowedTypes": [
        "images",
        "files",
        "videos",
        "audios"
      ]
    },
    "slug": {
      "type": "uid",
      "targetField": "titolo",
      "required": true
    },
    "pubblicato": {
      "type": "boolean",
      "required": true,
      "default": false
    },
    "autore": {
      "type": "string"
    }
  }
}
